---
// Shell estático del modal de detalle de producto. [slug].astro es
// quien lo llena y maneja la interacción (necesita acceso directo al
// arreglo `cart` y a updateUI(), que viven en su propio <script>).
---

<div class="pm-overlay" id="pm-overlay" onclick="handlePmOverlayClick(event)">
  <div class="pm-modal" id="pm-modal">
    <div class="pm-photo-wrap">
      <img id="pm-photo" class="pm-photo" src="" alt="" />
      <div class="pm-photo-placeholder" id="pm-photo-placeholder" style="display:none">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="rgba(199,85,31,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>
      </div>
      <button class="pm-back-btn" onclick="closeProductModal()" aria-label="Cerrar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
    </div>

    <div class="pm-body">
      <div class="pm-head-row">
        <h2 class="pm-name" id="pm-name"></h2>
        <span class="pm-price" id="pm-price"></span>
      </div>
      <span class="pm-badge" id="pm-badge" style="display:none">Popular</span>
      <p class="pm-desc" id="pm-desc"></p>

      <p class="pm-label">Cantidad</p>
      <div class="pm-qty-row">
        <button class="pm-qty-btn" id="pm-qty-minus" onclick="pmChangeQty(-1)" aria-label="Menos">−</button>
        <span class="pm-qty-value" id="pm-qty-value">1</span>
        <button class="pm-qty-btn" id="pm-qty-plus" onclick="pmChangeQty(1)" aria-label="Más">+</button>
      </div>

      <p class="pm-label">Notas especiales</p>
      <textarea class="pm-notes" id="pm-notes" rows="2" placeholder="Ej: sin cebolla, extra salsa..."></textarea>
    </div>

    <div class="pm-footer">
      <button class="pm-add-btn" id="pm-add-btn" onclick="pmAddToCart()">
        <span>Agregar al carrito</span>
        <span id="pm-add-total">$0</span>
      </button>
    </div>
  </div>
</div>

<style>
  .pm-overlay{
    display:none;position:fixed;inset:0;background:rgba(10,6,8,0.7);z-index:55;
    align-items:flex-end;justify-content:center;
  }
  @media(min-width:769px){ .pm-overlay{align-items:center} }
  .pm-modal{
    background:var(--color-fog-card,#fff);width:100%;max-width:440px;
    border-radius:16px 16px 0 0;max-height:92vh;overflow-y:auto;
  }
  @media(min-width:769px){ .pm-modal{border-radius:16px;max-height:86vh} }

  .pm-photo-wrap{position:relative;width:100%;height:220px;background:var(--color-fog-panel,#EDE3D0)}
  .pm-photo{width:100%;height:100%;object-fit:cover;display:block}
  .pm-photo-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .pm-back-btn{
    position:absolute;top:14px;left:14px;width:34px;height:34px;border-radius:50%;
    background:rgba(255,255,255,0.9);border:none;color:#1C1208;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
  }

  .pm-body{padding:18px 20px 4px}
  .pm-head-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .pm-name{font-family:'Cormorant Garamond',serif;font-size:24px;color:#1C1208}
  .pm-price{font-family:'Cormorant Garamond',serif;font-size:22px;color:#C7551F;white-space:nowrap}
  .pm-badge{
    display:inline-block;margin-top:6px;font-size:11px;font-weight:600;
    background:rgba(199,85,31,0.1);color:#C7551F;padding:3px 10px;border-radius:999px;
  }
  .pm-desc{font-size:14px;color:#8A7A62;line-height:1.6;margin-top:10px}

  .pm-label{
    font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
    color:#1C1208;margin-top:20px;margin-bottom:10px;
  }
  .pm-qty-row{display:flex;align-items:center;gap:16px}
  .pm-qty-btn{
    width:32px;height:32px;border-radius:50%;background:none;
    border:1px solid rgba(199,85,31,0.35);color:#C7551F;font-size:17px;
    cursor:pointer;display:flex;align-items:center;justify-content:center;
  }
  .pm-qty-value{font-size:16px;font-weight:600;color:#1C1208;min-width:14px;text-align:center}

  .pm-notes{
    width:100%;background:rgba(28,18,8,0.03);border:1px solid rgba(28,18,8,0.1);
    border-radius:8px;padding:12px 14px;font-size:14px;color:#1C1208;
    outline:none;resize:none;font-family:'Inter',sans-serif;
  }
  .pm-notes::placeholder{color:rgba(28,18,8,0.25)}

  .pm-footer{position:sticky;bottom:0;background:var(--color-fog-card,#fff);padding:16px 20px;margin-top:16px;border-top:0.5px solid rgba(28,18,8,0.08)}
  .pm-add-btn{
    width:100%;padding:14px 18px;background:#C7551F;border:none;border-radius:8px;
    color:#FAF6EE;font-size:14px;font-weight:600;cursor:pointer;
    display:flex;align-items:center;justify-content:space-between;font-family:'Inter',sans-serif;
  }
</style>
