---
export const prerender = false
import '../styles/global.css'
import Header from '../components/Header.astro'
import EtaChip from '../components/ui/EtaChip.astro'

// ← Vitrina de marketing, no un pedido real — no hay ruta ni dirección
// que calcular aquí, solo un ejemplo ilustrativo del feature.
const demoEta = { minutes: 22, km: 3.4 }
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Fogón — Sistema de Pedidos para Restaurantes sin Comisión</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <meta name="description" content="Sistema de gestión de pedidos en línea para restaurantes en México. Sin comisión por venta, pago fijo mensual de $299. Recibe pedidos a domicilio y para recoger con seguimiento en tiempo real."/>

  <!-- Open Graph -->
  <meta property="og:type" content="website"/>
  <meta property="og:title" content="Fogón — Sistema de Pedidos para Restaurantes sin Comisión"/>
  <meta property="og:description" content="Plataforma de pedidos en línea para restaurantes. Sin comisión por venta, sin intermediarios de reparto. Gestión de pedidos a domicilio y para recoger con tiempos de entrega reales."/>
  <meta property="og:url" content="https://fogon.inannadevweb.com"/>
  <meta property="og:image" content="https://fogon.inannadevweb.com/og-image.png"/>
  <meta property="og:locale" content="es_MX"/>
  <meta property="og:site_name" content="Fogón"/>

  <!-- Twitter/X -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="Fogón — Sistema de Pedidos para Restaurantes sin Comisión"/>
  <meta name="twitter:description" content="Sistema de pedidos en línea sin comisión por venta. Pago fijo mensual para restaurantes."/>

  <!-- SEO técnico -->
  <meta name="keywords" content="sistema de pedidos para restaurantes, plataforma de pedidos sin comisión, software para restaurantes México, gestión de pedidos en línea, pedidos a domicilio restaurante, alternativa a Rappi para restaurantes"/>
  <link rel="canonical" href="https://fogon.inannadevweb.com"/>
  <meta name="robots" content="index, follow"/>

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500;1,600;1,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:var(--color-fog-bg);
      --panel:var(--color-fog-panel);
      --card:var(--color-fog-card);
      --text:var(--color-fog-text);
      --muted:var(--color-fog-muted);
      --border:var(--color-fog-border);
      --accent:var(--color-fog-brasa);
      --accent-dim:rgba(199,85,31,0.1);
      --accent-border:rgba(199,85,31,0.25);
      --loss:#A23324;
      --gain:#2d6a45;
    }
    body{
      background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;
      line-height:1.55;overflow-x:hidden;
    }
    section{padding:104px 24px}
    @media(max-width:720px){section{padding:64px 20px}}
    .wrap{max-width:1040px;margin:0 auto}
    .eyebrow{
      font-size:12px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
      color:var(--muted);margin-bottom:18px;display:block;
    }
    h1,h2,h3{color:var(--text)}
    .btn-primary{
      display:inline-flex;align-items:center;gap:8px;
      background:var(--accent);color:#FAF6EE;
      border:none;border-radius:9px;padding:16px 30px;
      font-size:15px;font-weight:700;text-decoration:none;
      font-family:'Inter',sans-serif;transition:opacity 0.15s;
    }
    .btn-primary:hover{opacity:0.9}

    /* ── Hero ─────────────────────────────────────── */
    .hero{padding-top:40px;padding-bottom:28px;text-align:center}
    .hero h1{
      font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;
      font-size:clamp(38px,6.4vw,68px);line-height:1.08;
      letter-spacing:-0.5px;max-width:760px;margin:0 auto 24px;
    }
    .hero-sub{font-size:17px;color:var(--muted);max-width:520px;margin:0 auto 32px;line-height:1.65}
    .hero-ctas{display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;margin-bottom:76px}

    /* ── Comparación (apoyo visual del hero) ─────── */
    .compare-kicker{text-align:center;color:var(--muted);font-size:14px;margin-bottom:28px}
    .compare-pair{display:flex;justify-content:center;align-items:stretch;gap:24px;flex-wrap:wrap}
    .compare-card{
      width:270px;max-width:100%;background:var(--card);border:1px solid var(--border);
      border-radius:16px;padding:28px 26px;
      box-shadow:0 1px 2px rgba(0,0,0,0.04),0 8px 24px -8px rgba(28,18,8,0.08);
    }
    .compare-head{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:18px}
    .compare-line{display:flex;justify-content:space-between;font-size:14px;padding:6px 0;color:var(--text)}
    .compare-line span:first-child{color:var(--muted)}
    .compare-line.loss span:last-child{color:var(--loss);font-weight:700}
    .compare-line.gain span:last-child{color:var(--gain);font-weight:700}
    .compare-divider{border-top:1px solid var(--border);margin:14px 0}
    .compare-total{display:flex;justify-content:space-between;font-weight:800;font-size:17px}
    .compare-total.win{color:var(--gain)}
    .compare-note{text-align:center;margin-top:36px;color:var(--muted);font-size:15px}
    .compare-note strong{color:var(--text)}

    /* ── Section head genérico ────────────────────── */
    .section-head{margin-bottom:52px;max-width:520px}
    .section-head h2{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:clamp(28px,3.6vw,38px);letter-spacing:-0.3px}
    .section-head p{color:var(--muted);font-size:15px;margin-top:10px}

    /* ── Cómo funciona ────────────────────────────── */
    .flow{display:flex;flex-direction:column;gap:0;max-width:600px;margin:0 auto}
    .flow-step{display:flex;gap:22px;padding:28px 0;border-bottom:1px solid var(--border);text-align:left;align-items:flex-start}
    .flow-step:last-child{border-bottom:none}
    .flow-num{
      flex-shrink:0;width:46px;height:46px;border-radius:50%;
      background:var(--accent-dim);border:1px solid var(--accent-border);color:var(--accent);
      display:flex;align-items:center;justify-content:center;
      font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:700;
    }
    .flow-step h3{font-size:17px;font-weight:700;margin-bottom:6px}
    .flow-step p{color:var(--muted);font-size:14.5px;line-height:1.6}

    /* ── Features ─────────────────────────────────── */
    .features-section{background:var(--panel)}
    .features-list{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:820px;margin:0 auto}
    @media(max-width:640px){.features-list{grid-template-columns:1fr}}
    .feature-card{
      background:var(--card);border:1px solid var(--border);border-radius:14px;
      padding:24px 24px;text-align:left;border-bottom:2px solid transparent;
      transition:border-color 0.2s ease,box-shadow 0.2s ease;
    }
    .feature-card:hover{border-bottom-color:var(--accent);box-shadow:0 4px 16px -4px rgba(199,85,31,0.18)}
    .feature-card h3{font-size:15.5px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:8px}
    .feature-card h3::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);display:inline-block;flex-shrink:0}
    .feature-card p{font-size:13.5px;color:var(--muted);line-height:1.6}
    .feature-card.featured{grid-column:1 / -1;display:flex;align-items:center;gap:28px;flex-wrap:wrap}
    .feature-card.featured .feature-copy{flex:1;min-width:220px}
    .feature-card.featured .feature-demo{flex-shrink:0;width:280px;max-width:100%}
    @media(max-width:560px){.feature-card.featured{flex-direction:column;align-items:stretch}}

    /* ── Precio ───────────────────────────────────── */
    .price-card{
      max-width:400px;margin:0 auto;background:var(--card);border:1px solid var(--border);
      border-radius:20px;padding:44px 40px;text-align:center;
      box-shadow:0 1px 2px rgba(0,0,0,0.04),0 12px 32px -10px rgba(28,18,8,0.1);
    }
    .price-eyebrow{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--accent);margin-bottom:18px}
    .price-amount{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:clamp(48px,7vw,64px);line-height:1}
    .price-amount small{font-family:'Inter',sans-serif;font-size:16px;font-weight:600;color:var(--muted)}
    .price-lines{margin:26px 0 8px;display:flex;flex-direction:column;gap:10px}
    .price-line{display:flex;justify-content:space-between;font-size:14.5px;padding:10px 0;border-top:1px solid var(--border)}
    .price-line span:first-child{color:var(--muted)}
    .price-line span:last-child{font-weight:700}
    .price-line.zero span:last-child{color:var(--gain)}
    .price-cta-wrap{margin-top:30px}

    /* ── Confianza ────────────────────────────────── */
    .trust-list{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:820px;margin:0 auto;text-align:center}
    @media(max-width:720px){.trust-list{grid-template-columns:1fr;gap:36px}}
    .trust-item h3{font-size:15.5px;font-weight:700;margin-bottom:8px}
    .trust-item p{font-size:13.5px;color:var(--muted);line-height:1.6}
    .trust-icon{
      width:44px;height:44px;border-radius:50%;margin:0 auto 16px;
      background:var(--accent-dim);border:1px solid var(--accent-border);color:var(--accent);
      display:flex;align-items:center;justify-content:center;
    }

    /* ── CTA final ────────────────────────────────── */
    .final-cta{text-align:center}
    .final-mark{width:56px;height:56px;margin:0 auto 20px;opacity:0.85}
    .final-cta h2{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:clamp(28px,3.8vw,40px);margin-bottom:14px;letter-spacing:-0.3px}
    .final-cta p{color:var(--muted);font-size:15px;margin-bottom:32px;max-width:440px;margin-left:auto;margin-right:auto}

    /* ── Footer ───────────────────────────────────── */
    footer{
      padding:28px 24px;text-align:center;color:var(--muted);font-size:13px;
      border-top:1px solid var(--border);
    }
    .footer-links{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;row-gap:6px;margin-top:10px}
    .footer-links a{color:var(--muted);text-decoration:none}
    .footer-links a:hover{color:var(--text)}
  </style>
</head>
<body>

  <Header/>

  <!-- ── Hero + comparación ───────────────────────── -->
  <header class="hero wrap">
    <span class="eyebrow">Para restaurantes y negocios de comida en Chihuahua</span>
    <h1>Vende directo.<br/>Gana completo.</h1>
    <p class="hero-sub">Fogón es el sistema de pedidos para restaurantes. Sin comisión por venta, sin intermediarios de reparto — solo un pago fijo mensual y control total de tu negocio.</p>
    <div class="hero-ctas">
      <a class="btn-primary" href="/registro">Crea tu negocio gratis →</a>
    </div>
  </header>

  <section style="padding-top:0">
    <div class="wrap">
      <p class="compare-kicker">Dos formas de vender $10,000 al mes</p>
      <div class="compare-pair">
        <div class="compare-card">
          <p class="compare-head">Apps de delivery</p>
          <div class="compare-line"><span>Subtotal pedidos</span><span>$10,000.00</span></div>
          <div class="compare-line loss"><span>Comisión (25%)</span><span>-$2,500.00</span></div>
          <div class="compare-divider"></div>
          <div class="compare-total"><span>TE QUEDAS</span><span>$7,500.00</span></div>
        </div>
        <div class="compare-card">
          <p class="compare-head">Fogón</p>
          <div class="compare-line"><span>Subtotal pedidos</span><span>$10,000.00</span></div>
          <div class="compare-line gain"><span>Renta fija</span><span>-$299.00</span></div>
          <div class="compare-divider"></div>
          <div class="compare-total win"><span>TE QUEDAS</span><span>$9,701.00</span></div>
        </div>
      </div>
      <p class="compare-note"><strong>$2,701 más</strong> en tu bolsillo cada mes, vendiendo exactamente lo mismo.</p>
    </div>
  </section>

  <!-- ── Cómo funciona ────────────────────────────── -->
  <section>
    <div class="wrap" style="text-align:center">
      <div class="section-head" style="margin:0 auto 52px">
        <h2>De cero a recibiendo pedidos</h2>
      </div>
      <div class="flow">
        <div class="flow-step">
          <span class="flow-num">01</span>
          <div>
            <h3>Crea tu cuenta</h3>
            <p>Pon el nombre de tu negocio y tu correo. Menos de un minuto, sin tarjeta de crédito.</p>
          </div>
        </div>
        <div class="flow-step">
          <span class="flow-num">02</span>
          <div>
            <h3>Sube tu menú</h3>
            <p>Agrega tus productos, precios y fotos cuando quieras.</p>
          </div>
        </div>
        <div class="flow-step">
          <span class="flow-num">03</span>
          <div>
            <h3>Recibe pedidos en tu tienda en línea Fogón</h3>
            <p>Comparte tu link. Los pedidos llegan a tu panel en tiempo real, listos para confirmar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Qué incluye ──────────────────────────────── -->
  <section class="features-section">
    <div class="wrap">
      <div class="section-head" style="margin:0 auto 36px;text-align:center;max-width:none">
        <h2>Todo lo que ya incluye</h2>
      </div>
      <div class="features-list">
        <div class="feature-card">
          <h3>Pedidos en tiempo real</h3>
          <p>Tu cliente ve en el navegador cuando confirmas en tu dashboard.</p>
        </div>
        <div class="feature-card">
          <h3>Tu menú, tus reglas</h3>
          <p>Agrega categorías y productos cuando quieras, directo desde tu panel.</p>
        </div>
        <div class="feature-card">
          <h3>Horario automático</h3>
          <p>O pausa manualmente si necesitas un descanso.</p>
        </div>
        <div class="feature-card">
          <h3>Cobra como siempre</h3>
          <p>Efectivo, CLABE, DiMo o CoDi. El dinero va directo a tu cuenta, nunca pasa por Fogón.</p>
        </div>
        <div class="feature-card featured">
          <div class="feature-copy">
            <h3>Tiempos estimados de entrega y recolección</h3>
            <p>Tus clientes ven cuánto van a esperar antes de confirmar su pedido, para domicilio o para recoger.</p>
          </div>
          <div class="feature-demo">
            <EtaChip variant="compact" minutes={demoEta.minutes} km={demoEta.km} direction="delivery"/>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Precio ───────────────────────────────────── -->
  <section id="precio">
    <div class="wrap" style="text-align:center">
      <div class="price-card">
        <p class="price-eyebrow">Plan único, sin sorpresas</p>
        <p class="price-amount">$299 <small>MXN / mes</small></p>
        <div class="price-lines">
          <div class="price-line"><span>Instalación</span><span>$0.00</span></div>
          <div class="price-line zero"><span>Comisión por venta</span><span>0%</span></div>
        </div>
        <div class="price-cta-wrap">
          <a class="btn-primary" href="/registro">Crear mi cuenta</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Confianza ────────────────────────────────── -->
  <section class="features-section">
    <div class="wrap">
      <div class="section-head" style="margin:0 auto 44px;text-align:center;max-width:none">
        <h2>Sin letras chiquitas</h2>
      </div>
      <div class="trust-list">
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
          </div>
          <h3>Cancela cuando quieras</h3>
          <p>Sin permanencia mínima. Si un mes decides que no es para ti, te vas sin penalización.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
          </div>
          <h3>Sin contrato forzoso</h3>
          <p>Nada de letras chiquitas ni cláusulas de salida. Pagas mes a mes, cuando tú decides seguir.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
          </div>
          <h3>Convive con tu WhatsApp</h3>
          <p>Fogón no lo reemplaza de un jalón. Tus pedidos de siempre siguen llegando, y ahora tienes un canal más.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA final ────────────────────────────────── -->
  <section class="final-cta">
    <div class="wrap">
      <img src="/fogon-sello.svg" alt="" class="final-mark"/>
      <h2>Tu negocio. Tus reglas. Tu dinero.</h2>
      <p>Crea tu cuenta hoy: $0 de instalación, $299 MXN al mes, 0% de comisión por pedido.</p>
      <a class="btn-primary" href="/registro">Crear mi negocio gratis →</a>
    </div>
  </section>

  <footer>
    Fogón — hecho en Chihuahua, para negocios de Chihuahua.
    <div class="footer-links">
      <a href="/terminos">Términos y Condiciones</a>
      <a href="/privacidad">Aviso de Privacidad</a>
    </div>
  </footer>

</body>
</html>
