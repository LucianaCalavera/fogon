---
import '../styles/global.css'
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>No encontrado — Fogón</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{
      min-height:100vh;background:#0A0608;color:#FAF6F0;
      font-family:'Inter',sans-serif;
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      text-align:center;padding:32px;
    }
    .flame{font-size:56px;margin-bottom:24px}
    h1{
      font-family:'Cormorant Garamond',serif;font-style:italic;
      font-size:30px;font-weight:600;color:#FAF6F0;margin-bottom:12px;
    }
    p{color:#7A5840;font-size:15px;line-height:1.6;margin-bottom:32px}
    a{
      color:#B04030;font-size:14px;text-decoration:none;
      border-bottom:1px solid rgba(176,64,48,0.3);
      padding-bottom:2px;transition:opacity 0.15s;
    }
    a:hover{opacity:0.75}
  </style>
</head>
<body>
  <p class="flame">🔥</p>
  <h1>Este negocio no existe</h1>
  <p>Verifica el link que te compartieron</p>
  <a href="/">Volver al inicio</a>
</body>
</html>