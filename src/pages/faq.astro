---
export const prerender = false
import '../styles/global.css'
import Header from '../components/Header.astro'

const faqs = [
  {
    q: '¿Cuánto cuesta?',
    a: '$0 de alta, $299 MXN al mes plano, sin comisión por pedido.',
  },
  {
    q: '¿Necesito instalar algo?',
    a: 'No, Fogón se usa directo desde el navegador, sin descargar nada de tiendas de apps.',
  },
  {
    q: '¿Qué pasa si se va el internet?',
    a: 'No se pierde nada. En cuanto regresa la señal, todo se actualiza solo.',
  },
  {
    q: '¿Cómo sé cuándo llega un pedido nuevo o cambia de estatus?',
    a: 'Recibes una notificación push en tu celular, pero como su confiabilidad depende de la configuración de cada equipo, lo más seguro es dejar abierta la pantalla de seguimiento de tu pedido: ahí se actualiza en tiempo real.',
  },
  {
    q: '¿Puedo tener varias sucursales?',
    a: 'Próximamente (en las siguientes semanas). Por ahora, cada local se maneja de forma independiente, con su propio panel.',
  },
  {
    q: '¿Cómo calculan el tiempo de entrega?',
    a: 'Con GPS real, no estimado a mano.',
  },
  {
    q: '¿Hay contrato o permanencia mínima?',
    a: 'No, es mes a mes. Si dejas de pagar, se da de baja automáticamente, sin penalización.',
  },
  {
    q: '¿Cómo cancelo?',
    a: 'Solo dejas de pagar la mensualidad, no hay ningún proceso de baja que hacer.',
  },
]
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Preguntas Frecuentes — Fogón</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <meta name="description" content="Resolvemos las dudas más comunes sobre Fogón: precio, instalación, funcionamiento sin internet, notificaciones de pedidos, sucursales, tiempos de entrega y cancelación."/>
  <link rel="canonical" href="https://fogon.inannadevweb.com/faq"/>
  <meta name="robots" content="index, follow"/>

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  })}/>

  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--color-fog-bg);color:var(--color-fog-text);font-family:'Inter',sans-serif;line-height:1.55}

    main{max-width:720px;margin:0 auto;padding:24px 24px 96px}

    .faq-hero{text-align:center;padding:24px 0 52px}
    .faq-eyebrow{
      font-size:12px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
      color:var(--color-fog-muted);margin-bottom:16px;display:block;
    }
    .faq-hero h1{
      font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;
      font-size:clamp(32px,5.5vw,46px);letter-spacing:-0.3px;color:var(--color-fog-text);
      margin-bottom:14px;
    }
    .faq-hero p{color:var(--color-fog-muted);font-size:15px;max-width:460px;margin:0 auto}

    .faq-list{display:flex;flex-direction:column}

    .faq-item{
      border-bottom:1px solid var(--color-fog-border);
      overflow:hidden;
    }
    .faq-item:first-child{border-top:1px solid var(--color-fog-border)}

    .faq-question{
      display:flex;align-items:center;justify-content:space-between;gap:20px;
      list-style:none;cursor:pointer;padding:22px 4px;
      font-size:16px;font-weight:600;color:var(--color-fog-text);
    }
    .faq-question::-webkit-details-marker{display:none}
    .faq-question:hover{color:var(--color-fog-brasa)}
    .faq-question:focus-visible{outline:2px solid var(--color-fog-brasa);outline-offset:4px;border-radius:4px}

    .faq-icon{
      flex-shrink:0;width:22px;height:22px;border-radius:50%;
      background:rgba(199,85,31,0.1);border:1px solid rgba(199,85,31,0.25);color:var(--color-fog-brasa);
      display:flex;align-items:center;justify-content:center;
      transition:transform 0.25s ease;
    }
    .faq-item[open] .faq-icon{transform:rotate(45deg)}

    .faq-answer-wrap{padding:0 4px 22px}
    .faq-answer{color:var(--color-fog-muted);font-size:14.5px;line-height:1.7;max-width:600px}

    @media(prefers-reduced-motion: reduce){
      .faq-icon{transition:none}
    }

    .faq-footer-cta{
      text-align:center;margin-top:56px;padding-top:44px;border-top:1px solid var(--color-fog-border);
    }
    .faq-footer-cta p{color:var(--color-fog-muted);font-size:14.5px;margin-bottom:20px}
    .btn-primary{
      display:inline-flex;align-items:center;gap:8px;
      background:var(--color-fog-brasa);color:#FAF6EE;
      border:none;border-radius:9px;padding:14px 26px;
      font-size:14.5px;font-weight:700;text-decoration:none;
      font-family:'Inter',sans-serif;transition:opacity 0.15s;
    }
    .btn-primary:hover{opacity:0.9}

    footer{
      padding:28px 24px;text-align:center;color:var(--color-fog-muted);font-size:13px;
      border-top:1px solid var(--color-fog-border);
    }
    .footer-links{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;row-gap:6px;margin-top:10px}
    .footer-links a{color:var(--color-fog-muted);text-decoration:none}
    .footer-links a:hover{color:var(--color-fog-text)}
  </style>
</head>
<body>

  <Header active="faq"/>

  <main>
    <div class="faq-hero">
      <span class="faq-eyebrow">Ayuda</span>
      <h1>Preguntas frecuentes</h1>
      <p>Todo lo que necesitas saber antes de crear tu negocio en Fogón.</p>
    </div>

    <div class="faq-list">
      {faqs.map(({ q, a }) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <div class="faq-answer-wrap">
            <p class="faq-answer">{a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-footer-cta">
      <p>¿No encontraste lo que buscabas?</p>
      <a class="btn-primary" href="/registro">Crear mi negocio gratis →</a>
    </div>
  </main>

  <footer>
    Fogón — hecho en Chihuahua, para negocios de Chihuahua.
    <div class="footer-links">
      <a href="/terminos">Términos y Condiciones</a>
      <a href="/privacidad">Aviso de Privacidad</a>
    </div>
  </footer>

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    class Accordion {
      el: HTMLDetailsElement
      summary: HTMLElement
      content: HTMLElement
      animation: Animation | null = null
      isClosing = false
      isExpanding = false

      constructor(el: HTMLDetailsElement) {
        this.el = el
        this.summary = el.querySelector('summary')!
        this.content = el.querySelector('.faq-answer-wrap')!
        this.summary.addEventListener('click', (e) => this.onClick(e))
      }

      onClick(e: Event) {
        e.preventDefault()
        this.el.style.overflow = 'hidden'

        if (prefersReducedMotion) {
          this.el.open = !this.el.open
          this.el.style.overflow = ''
          return
        }

        if (this.isClosing || !this.el.open) {
          this.open()
        } else if (this.isExpanding || this.el.open) {
          this.shrink()
        }
      }

      shrink() {
        this.isClosing = true
        const startHeight = `${this.el.offsetHeight}px`
        const endHeight = `${this.summary.offsetHeight}px`

        if (this.animation) this.animation.cancel()

        this.animation = this.el.animate(
          { height: [startHeight, endHeight] },
          { duration: 220, easing: 'ease-out' }
        )
        this.animation.onfinish = () => this.onAnimationFinish(false)
        this.animation.oncancel = () => { this.isClosing = false }
      }

      open() {
        this.el.style.height = `${this.el.offsetHeight}px`
        this.el.open = true
        window.requestAnimationFrame(() => this.expand())
      }

      expand() {
        this.isExpanding = true
        const startHeight = `${this.el.offsetHeight}px`
        const endHeight = `${this.summary.offsetHeight + this.content.offsetHeight}px`

        if (this.animation) this.animation.cancel()

        this.animation = this.el.animate(
          { height: [startHeight, endHeight] },
          { duration: 220, easing: 'ease-out' }
        )
        this.animation.onfinish = () => this.onAnimationFinish(true)
        this.animation.oncancel = () => { this.isExpanding = false }
      }

      onAnimationFinish(open: boolean) {
        this.el.open = open
        this.animation = null
        this.isClosing = false
        this.isExpanding = false
        this.el.style.height = ''
        this.el.style.overflow = ''
      }
    }

    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((el) => new Accordion(el))
  </script>
</body>
</html>
