---
export const prerender = false
import '../../styles/global.css'
import { supabase } from '../../lib/supabase'
import EtaChip from '../../components/ui/EtaChip.astro'
import { DEFAULT_PREP_MINUTES } from '../../lib/eta'

const { id } = Astro.params

// order_status_public es la única tabla con SELECT público — por diseño
// no expone nombre/teléfono/dirección del cliente, solo el estado.
const { data: tracking, error } = await supabase
  .from('order_status_public')
  .select('*')
  .eq('order_id', id)
  .maybeSingle()

const notFound = !tracking || !!error
const orderType = tracking?.order_type ?? 'pickup'
const initialStatus = tracking?.status ?? 'pending'
const orderShortId = id ? id.slice(-6).toUpperCase() : '000'

// PAGOS: cuando el pedido viene del checkout con transferencia,
// [slug].astro pasa estos datos por la URL para armar el link de
// WhatsApp aquí, evitando la pelea entre window.open() y la
// redirección que fallaba antes.
const waNumber = Astro.url.searchParams.get('wa')
const waAmount = Astro.url.searchParams.get('amt')
const waOrderNum = Astro.url.searchParams.get('num')

// El link de seguimiento va AL INICIO del mensaje del comprobante —
// como este mensaje lo manda el cliente de cualquier forma, queda
// guardado solo en su propio historial de WhatsApp, sin pedirle
// una acción extra (a diferencia de "Guardar este link", que sigue
// existiendo para los pedidos en efectivo, donde no hay mensaje).
const trackingUrl = new URL(`/pedido/${id}`, Astro.url).toString()
const waMessage = waNumber
  ? `🔗 Mi pedido: ${trackingUrl}\n\nHola, ya transferí ${waAmount} de mi pedido ${waOrderNum}. Aquí está mi comprobante 👇 (adjunta la foto de tu transferencia en este chat)`
  : ''
const waUrl = waNumber ? `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}` : null

// El slug viene directo por la URL desde [slug].astro al crear el
// pedido (mismo patrón que wa/amt/num) — no depende de que
// order_status_public tenga business_id, que es lo que fallaba antes.
let businessSlug = Astro.url.searchParams.get('slug') || null

// Respaldo para links viejos que ya estén circulando sin ?slug=.
if (!businessSlug && !notFound && tracking?.business_id) {
  const { data: biz } = await supabase
    .from('businesses')
    .select('slug')
    .eq('id', tracking.business_id)
    .maybeSingle()
  businessSlug = biz?.slug ?? null
}

// Domicilio calcula y guarda la ruta real (restaurante → dirección)
// con OSRM en el checkout. Recoger no puede hacer eso ahí (no hay
// geolocalización del cliente en el checkout) — la calcula y guarda
// esta misma pantalla, del lado del cliente, la primera vez que se
// abre (más abajo, vía navigator.geolocation + la función RPC
// set_pickup_eta). Una vez guardada, ambos tipos leen aquí por igual.
const hasStoredEta = tracking?.eta_minutes != null
const eta = hasStoredEta
  ? { minutes: tracking.eta_minutes, km: tracking.eta_km }
  : { minutes: DEFAULT_PREP_MINUTES }

// Mismo criterio que hasStoredEta: solo hay ruta que dibujar si ya
// quedó guardada (en el checkout para domicilio, o en una visita
// anterior a esta pantalla para recoger). Se muestra siempre visible
// aquí (a diferencia del dashboard) porque el cliente solo ve su
// propio pedido.
const routeGeometry = tracking?.eta_route_geometry ?? null

// Coordenadas del restaurante para el ETA real de "Recoger" (ruta
// cliente → restaurante), calculado en el navegador una vez que se
// obtiene la geolocalización del cliente. La ubicación del negocio
// es pública (ya se muestra en el mapa de la tienda), así que
// consultarla aquí no rompe ninguna barrera de privacidad. No hace
// falta si ya existe un ETA guardado de una visita anterior.
let businessCoords = null
if (orderType === 'pickup' && businessSlug && !hasStoredEta) {
  const { data: biz } = await supabase
    .from('businesses')
    .select('latitude, longitude')
    .eq('slug', businessSlug)
    .maybeSingle()
  if (biz?.latitude && biz?.longitude) businessCoords = { lat: biz.latitude, lng: biz.longitude }
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Seguimiento de pedido #{orderShortId} — Fogón</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --cream:var(--color-fog-bg);
      --teja:var(--color-fog-brasa);
      --teja-dim:rgba(199,85,31,0.12);
      --teja-border:rgba(199,85,31,0.3);
      --text-dark:var(--color-fog-text);
      --text-muted:var(--color-fog-muted);
    }
    body{
      background:var(--cream);color:var(--text-dark);font-family:'Inter',sans-serif;
      min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
      padding:32px;text-align:center;
    }

    .success-sello{width:76px;height:76px;margin:0 auto 24px;display:block}
    .success-eta{width:100%;max-width:300px;margin:4px auto 20px}
    .route-map{width:100%;max-width:340px;height:220px;border-radius:14px;overflow:hidden;margin:0 auto 20px;border:1px solid rgba(0,0,0,0.08)}
    .success-title{font-family:'Cormorant Garamond',serif;font-size:30px;font-style:italic;color:var(--text-dark);margin-bottom:8px}
    .success-sub{font-size:14px;color:var(--text-muted);margin-bottom:20px;font-family:'Inter',sans-serif}
    .success-num{font-family:'Cormorant Garamond',serif;font-size:44px;color:var(--teja);margin-bottom:24px}

    .status-track{
      display:flex;flex-direction:column;align-items:center;
      gap:10px;margin:16px 0 24px;width:100%;max-width:300px;
    }
    .status-step{
      display:flex;align-items:center;gap:12px;
      width:100%;padding:10px 16px;border-radius:10px;
      background:rgba(42,24,16,0.06);
      font-family:'Inter',sans-serif;font-size:14px;
      color:var(--text-muted);transition:all 0.4s ease;
    }
    .status-step.active{
      background:rgba(199,85,31,0.1);
      color:var(--teja);border:1px solid rgba(199,85,31,0.2);
    }
    .status-step.done{
      background:rgba(74,222,128,0.08);
      color:#2d7a4a;border:1px solid rgba(74,222,128,0.2);
    }
    .status-step.cancelled{
      background:rgba(248,113,113,0.08);
      color:#c0392b;border:1px solid rgba(248,113,113,0.2);
    }
    .step-icon{font-size:18px;flex-shrink:0}
    .step-text{flex:1;text-align:left}
    .step-label{font-weight:600;font-size:13px}
    .step-sub{font-size:12px;opacity:0.7;margin-top:2px}
    .status-pulse{
      width:8px;height:8px;border-radius:50%;
      background:var(--teja);flex-shrink:0;
      animation:spulse 1.5s ease-in-out infinite;
    }
    @keyframes spulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.4;transform:scale(0.7)}}

    .back-link{margin-top:8px;color:var(--teja);font-size:14px;text-decoration:underline;font-family:'Inter',sans-serif}
    .not-found-note{font-size:14px;color:var(--text-muted);max-width:280px;line-height:1.6;margin-top:8px}
    .wa-receipt-btn{
      display:inline-flex;align-items:center;gap:8px;
      background:#25D366;color:#fff;text-decoration:none;
      border-radius:10px;padding:11px 20px;font-size:14px;font-weight:600;
      font-family:'Inter',sans-serif;margin-bottom:20px;
    }
    .save-link-btn{
      display:inline-flex;align-items:center;gap:8px;
      background:none;color:var(--teja);border:1px solid var(--teja-border);
      border-radius:10px;padding:9px 18px;font-size:13px;font-weight:600;
      cursor:pointer;font-family:'Inter',sans-serif;margin-bottom:20px;
    }
    .back-link-cta{
      display:inline-flex;align-items:center;gap:8px;
      background:var(--teja);color:#FFFFFF;
      text-decoration:none;border-radius:10px;
      padding:13px 26px;font-size:15px;font-weight:700;
      margin-top:6px;
    }
    .redirect-countdown{font-size:12px;color:var(--text-muted);margin-top:10px;font-family:'Inter',sans-serif}
  </style>
</head>
<body>
  {notFound ? (
    <>
      <img src="/fogon-sello.svg" alt="" class="success-sello" style="opacity:0.4" />
      <h1 class="success-title">No encontramos ese pedido</h1>
      <p class="not-found-note">Revisa el link que te compartieron, o pregúntale al negocio directamente por tu pedido.</p>
    </>
  ) : (
    <>
      <img src="/fogon-sello.svg" alt="" class="success-sello" />
      <h1 class="success-title" id="success-title">¡Pedido recibido!</h1>
      <p class="success-sub">Tu número de pedido</p>
      <p class="success-num">#{orderShortId}</p>

      <div class="success-eta" id="eta-chip-wrap">
        <EtaChip minutes={eta.minutes} km={eta.km} direction={orderType === 'delivery' ? 'delivery' : 'pickup'} variant="compact" />
      </div>

      {routeGeometry ? (
        <div class="route-map" id="route-map"></div>
      ) : (orderType === 'pickup' && businessCoords) && (
        // Sin ruta guardada todavía, pero sí es posible calcularla en
        // el navegador (más abajo, con la geolocalización del
        // cliente) — el contenedor se renderiza aquí, oculto, en vez
        // de crearlo por JS: un <div> creado con document.createElement
        // no lleva el atributo data-astro-cid-* que Astro usa para
        // aplicarle el CSS de .route-map (ancho/alto), y quedaría en
        // un mapa de 0×0 invisible.
        <div class="route-map" id="route-map" style="display:none"></div>
      )}

      {waUrl && (
        <a class="wa-receipt-btn" href={waUrl} target="_blank" rel="noopener">
          📤 Enviar comprobante por WhatsApp
        </a>
      )}

      <div>
        <button class="save-link-btn" id="save-link-btn" onclick="saveTrackingLink()">
          💾 Guardar este link
        </button>
      </div>

      <div class="status-track">
        <div class="status-step active" id="step-pending">
          <span class="step-icon">🕐</span>
          <div class="step-text">
            <p class="step-label">Esperando confirmación</p>
            <p class="step-sub">El negocio revisará tu pedido</p>
          </div>
          <span class="status-pulse" id="pulse-pending"></span>
        </div>
        <div class="status-step" id="step-confirmed">
          <span class="step-icon">👨‍🍳</span>
          <div class="step-text">
            <p class="step-label">Confirmado — En preparación</p>
            <p class="step-sub">Tu pedido está siendo preparado</p>
          </div>
        </div>
        <div class="status-step" id="step-ready">
          <span class="step-icon" id="ready-icon">🎉</span>
          <div class="step-text">
            <p class="step-label" id="ready-label">Listo</p>
            <p class="step-sub" id="ready-sub">Tu pedido está listo</p>
          </div>
        </div>
      </div>

      {businessSlug && <a class="back-link" id="back-link" href={`/${businessSlug}`}>Hacer otro pedido</a>}
      {businessSlug && <p class="redirect-countdown" id="redirect-countdown" style="display:none"></p>}
    </>
  )}

  <div id="track-cfg" data-order-id={id} data-order-type={orderType} data-initial-status={initialStatus} data-business-id={tracking?.business_id ?? ''} data-business-slug={businessSlug ?? ''} data-biz-lat={businessCoords?.lat ?? ''} data-biz-lng={businessCoords?.lng ?? ''} data-has-stored-eta={String(hasStoredEta)} hidden></div>
  {routeGeometry && <script type="application/json" id="route-geometry-data" set:html={JSON.stringify(routeGeometry)} />}

  {!notFound && (
    <script>
      import { createClient } from '@supabase/supabase-js'
      import { routeEta } from '../../lib/eta'
      import { renderRouteMap } from '../../lib/routeMap'
      import 'leaflet/dist/leaflet.css'

      // El servidor ya renderizó #route-map oculto cuando hay chance
      // de que Recoger calcule una ruta aquí (ver frontmatter) — no se
      // crea por JS: un <div> creado con document.createElement no
      // lleva el atributo data-astro-cid-* que Astro usa para
      // aplicarle el CSS de .route-map (ancho/alto), y quedaría en un
      // mapa de 0×0 invisible.
      function ensureRouteMapContainer() {
        const mapEl = document.getElementById('route-map')
        if (mapEl) mapEl.style.display = 'block'
        return mapEl
      }

      const sb = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY)

      const cfg = document.getElementById('track-cfg')

      // Mapa siempre visible (no colapsado, a diferencia del
      // dashboard) porque esta pantalla es del cliente y solo muestra
      // su propio pedido — no hay varias tarjetas que saturar.
      const routeGeometryEl = document.getElementById('route-geometry-data')
      if (routeGeometryEl) {
        const geometry = JSON.parse(routeGeometryEl.textContent)
        if (geometry?.coordinates?.length) renderRouteMap('route-map', geometry.coordinates, { interactive: true })
      }

      window.saveTrackingLink = async () => {
        const url = window.location.href
        const btn = document.getElementById('save-link-btn')
        const orderNum = document.querySelector('.success-num')?.textContent ?? ''

        // En celular: abre el menú nativo de compartir (WhatsApp,
        // Notas, lo que sea) — la persona elige dónde se lo manda
        // a sí misma. No necesita la API de WhatsApp Business.
        if (navigator.share) {
          try {
            await navigator.share({ title: `Mi pedido ${orderNum} — Fogón`, url })
            return
          } catch (e) { /* canceló el share, no se hace nada */ return }
        }

        // En escritorio (sin share nativo): se copia el link.
        try {
          await navigator.clipboard.writeText(url)
          const original = btn.textContent
          btn.textContent = '¡Link copiado!'
          setTimeout(() => { btn.textContent = original }, 2000)
        } catch (e) {
          btn.textContent = url
        }
      }
      const orderId = cfg.dataset.orderId
      const orderType = cfg.dataset.orderType
      const initialStatus = cfg.dataset.initialStatus
      const businessId = cfg.dataset.businessId
      const businessSlug = cfg.dataset.businessSlug

      // Recoger: solicita la ubicación del navegador de forma pasiva
      // (una sola vez, sin explicarle nada antes ni insistir después)
      // para mostrar la ruta real cliente → restaurante, igual que
      // Domicilio calcula restaurante → dirección en el checkout. Si
      // ya hay un ETA guardado de una visita anterior (hasStoredEta),
      // no hace falta volver a pedir permiso ni recalcular — SSR ya
      // mostró el chip y el mapa arriba. Si el permiso se niega, no
      // está disponible, o faltan las coordenadas del restaurante,
      // el chip se queda tal cual quedó renderizado en el servidor
      // (tiempo de preparación).
      const bizLat = parseFloat(cfg.dataset.bizLat ?? '')
      const bizLng = parseFloat(cfg.dataset.bizLng ?? '')
      const hasStoredEta = cfg.dataset.hasStoredEta === 'true'
      if (orderType === 'pickup' && !hasStoredEta && !isNaN(bizLat) && !isNaN(bizLng) && navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            const eta = await routeEta(
              { lat: pos.coords.latitude, lng: pos.coords.longitude },
              { lat: bizLat, lng: bizLng }
            )
            if (!eta) return
            const combined = document.querySelector('#eta-chip-wrap .eta-combined')
            if (combined) {
              const kmLabel = eta.km.toLocaleString('es-MX', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
              combined.textContent = `${eta.minutes} min · ${kmLabel} km`
            }

            if (eta.geometry?.coordinates?.length && ensureRouteMapContainer()) {
              renderRouteMap('route-map', eta.geometry.coordinates, { interactive: true })
            }

            // Guarda el ETA real en el pedido (vía RPC acotada — el
            // cliente no tiene sesión, y esta función solo deja
            // escribir eta_* en un pedido "pickup" que todavía no
            // tenga uno) para que el dashboard del negocio deje de
            // mostrar el fallback de 15 min, igual que ya pasa con
            // Domicilio desde el checkout.
            await sb.rpc('set_pickup_eta', {
              p_order_id: orderId,
              p_minutes: eta.minutes,
              p_km: eta.km,
              p_geometry: eta.geometry ?? null
            })
          },
          () => { /* denegado o no disponible — se queda el tiempo de preparación, sin insistir */ },
          { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 }
        )
      }

      // El pedido ya terminó (entregado o cancelado) — se borra el
      // aviso de "pedido reciente" de la tienda para que no se quede
      // apuntando a algo que ya no aplica.
      function clearRecentOrder() {
        if (!businessId) return
        try { localStorage.removeItem(`fogon_last_order_${businessId}`) } catch (e) {}
      }

      let audioCtx = null
      document.addEventListener('click', () => {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)()
      }, { once: true })

      function playStatusSound(status) {
        try {
          const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)()
          audioCtx = ctx
          const tones = {
            confirmed: [660, 880],
            ready:     [660, 880, 1100],
            delivered: [880, 660],
            cancelled: [440, 330]
          }[status] || [800]

          tones.forEach((freq, i) => {
            const osc = ctx.createOscillator()
            const gain = ctx.createGain()
            osc.connect(gain); gain.connect(ctx.destination)
            osc.frequency.value = freq
            osc.type = 'sine'
            const t = i * 0.16
            gain.gain.setValueAtTime(0, ctx.currentTime + t)
            gain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + t + 0.02)
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + t + 0.22)
            osc.start(ctx.currentTime + t)
            osc.stop(ctx.currentTime + t + 0.24)
          })
        } catch(e) {}
      }

      let lastTrackedStatus = null

      function setStep(status) {
        if (lastTrackedStatus !== null && status !== lastTrackedStatus) {
          playStatusSound(status)
        }
        lastTrackedStatus = status

        const steps = ['pending','confirmed','ready']
        steps.forEach(s => {
          const el = document.getElementById(`step-${s}`)
          if (el) el.className = 'status-step'
        })
        const pulse = document.getElementById('pulse-pending')
        if (pulse) pulse.style.display = 'none'

        if (status === 'cancelled') {
          const pending = document.getElementById('step-pending')
          if (pending) { pending.className = 'status-step cancelled'; pending.querySelector('.step-label').textContent = 'Pedido cancelado'; pending.querySelector('.step-sub').textContent = 'Contacta al negocio para más info' }
          document.getElementById('success-title').textContent = '❌ Pedido cancelado'
          clearRecentOrder()
          return
        }

        const order = ['pending','confirmed','ready','delivered']
        const idx = order.indexOf(status)

        if (idx >= 0) {
          const el = document.getElementById('step-pending')
          if (el) el.className = idx > 0 ? 'status-step done' : 'status-step active'
          if (idx === 0 && pulse) pulse.style.display = 'block'
        }
        if (idx >= 1) {
          const el = document.getElementById('step-confirmed')
          if (el) el.className = idx > 1 ? 'status-step done' : 'status-step active'
        }
        if (idx >= 2) {
          const el = document.getElementById('step-ready')
          if (el) el.className = 'status-step active'
          document.getElementById('success-title').textContent = '🎉 ¡Tu pedido está listo!'
        }
        if (status === 'delivered') {
          const el = document.getElementById('step-ready')
          if (el) el.className = 'status-step done'
          document.getElementById('success-title').textContent = '✅ ¡Entregado! Buen provecho'
          clearRecentOrder()
          const back = document.getElementById('back-link')
          if (back) { back.classList.add('back-link-cta'); back.textContent = '🍽️ Hacer otro pedido' }

          // Redirige de vuelta a la tienda automáticamente después de
          // unos segundos — así no se queda la pantalla "muerta"
          // esperando a que el cliente sepa que tiene que volver él mismo.
          if (businessSlug) {
            let secondsLeft = 8
            const countdown = document.getElementById('redirect-countdown')
            if (countdown) {
              countdown.style.display = 'block'
              countdown.textContent = `Te llevamos al menú en ${secondsLeft}s…`
              const interval = setInterval(() => {
                secondsLeft--
                if (secondsLeft <= 0) {
                  clearInterval(interval)
                  window.location.href = `/${businessSlug}`
                } else {
                  countdown.textContent = `Te llevamos al menú en ${secondsLeft}s…`
                }
              }, 1000)
            }
          }
        }
      }

      // Etiquetas según pickup/delivery
      const readyLabel = document.getElementById('ready-label')
      const readySub = document.getElementById('ready-sub')
      const readyIcon = document.getElementById('ready-icon')
      if (orderType === 'pickup') {
        readyLabel.textContent = '¡Listo para recoger!'
        readySub.textContent = 'Puedes pasar a recoger tu pedido'
        readyIcon.textContent = '🏪'
      } else {
        readyLabel.textContent = '¡En camino!'
        readySub.textContent = 'Tu pedido va en camino'
        readyIcon.textContent = '🛵'
      }

      // Estado inicial (SSR) — no suena, solo lo más reciente cambia el sonido
      setStep(initialStatus)

      // ── Tiempo real ──────────────────────────────
      // El filtro es por order_id, no por id: usar id causaba que la
      // actualización nunca llegara al cliente.
      sb.channel(`order-track-${orderId}`)
        .on('postgres_changes', {
          event: 'UPDATE', schema: 'public', table: 'order_status_public',
          filter: `order_id=eq.${orderId}`
        }, payload => {
          setStep(payload.new.status)
        })
        .subscribe()
    </script>
  )}
</body>
</html>