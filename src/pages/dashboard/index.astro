---
export const prerender = false
import '../../styles/global.css'
import { createServerClient, parseCookieHeader } from '@supabase/ssr'
import { getBusinessStatus } from '../../lib/schedule'
import Sidebar from '../../components/dashboard/Sidebar.astro'
import EtaChip from '../../components/ui/EtaChip.astro'
import { DEFAULT_PREP_MINUTES } from '../../lib/eta'
import { statusLabel, statusColor, statusBg, bucketOf } from '../../lib/orderStatus'

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() { return parseCookieHeader(Astro.request.headers.get('Cookie') ?? '') },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => Astro.cookies.set(name, value, options))
      },
    },
  }
)

const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

const { data: business } = await supabase
  .from('businesses').select('*').eq('owner_id', user.id).single()
if (!business) return Astro.redirect('/login')

const ownerClabe = import.meta.env.FOGON_OWNER_CLABE ?? ''
const ownerPhone = import.meta.env.FOGON_OWNER_PHONE ?? ''
const ownerBankName = import.meta.env.FOGON_OWNER_BANK_NAME ?? ''

const { data: orders } = await supabase
  .from('orders').select('*, order_items(*)').eq('business_id', business.id)
  .order('created_at', { ascending: false }).limit(50)

const allOrders = orders ?? []

const today = new Date().toDateString()
const todayOrders = allOrders.filter(o => new Date(o.created_at).toDateString() === today)
const todaySales = todayOrders.reduce((s, o) => s + Number(o.total), 0)

const pendingOrders = allOrders.filter(o => o.status === 'pending')
const confirmedOrders = allOrders.filter(o => o.status === 'confirmed')
const readyOrders = allOrders.filter(o => o.status === 'ready')
const doneOrders = allOrders.filter(o => o.status === 'delivered' || o.status === 'cancelled')
const activeOrdersCount = pendingOrders.length + confirmedOrders.length + readyOrders.length

// Se manda aparte (no dentro del objeto `order` que ya viaja en el
// HTML de cada tarjeta) porque el cliente lo necesita como dato puro
// para inicializar el mapa Leaflet, no para renderizarlo con Astro.
const routeGeometryByOrder = Object.fromEntries(
  allOrders.filter(o => o.eta_route_geometry).map(o => [o.id, o.eta_route_geometry])
)

const formatPrice = (n) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n)
const formatTime = (ts) => new Date(ts).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })

// El dashboard no pide geolocalización (quien mira esta pantalla es
// el negocio, no el cliente) — el ETA real de ambos tipos de pedido se
// calcula del lado del cliente (checkout para Domicilio, /pedido/[id]
// para Recoger) y queda guardado en el pedido. Si no hay uno guardado
// todavía, cae al tiempo de preparación.
const orderEta = (order) => order.eta_minutes != null
  ? { minutes: order.eta_minutes, km: order.eta_km }
  : { minutes: DEFAULT_PREP_MINUTES }
const now = new Date()
const dateLabel = now.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' })
const capitalize = (s) => s.charAt(0).toUpperCase() + s.slice(1)
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — {business.name}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--color-fog-brasa);
      --accent-dim: rgba(199,85,31,0.1);
      --accent-border: rgba(199,85,31,0.25);
      --border: var(--color-fog-dash-border);
      --danger: #f87171;
      --danger-dim: rgba(248,113,113,0.1);
      --danger-border: rgba(248,113,113,0.25);
    }
    body { background: var(--color-fog-dash-bg); color: var(--color-fog-dash-text); font-family: 'Inter', sans-serif; }

    .dash-layout { display: flex; min-height: 100vh; }
    @media (max-width: 900px) { .dash-layout { flex-direction: column; } }
    .dash-content { flex: 1; min-width: 0; padding: 28px 32px 48px; }
    @media (max-width: 640px) { .dash-content { padding: 20px 16px 32px; } }

    .pending-payment-banner { background: var(--danger-dim); border: 1px solid var(--danger-border); border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; }
    .pending-title { font-size: 14px; font-weight: 700; color: #c0392b; margin-bottom: 6px; }
    .pending-text { font-size: 13px; color: var(--color-fog-dash-muted); line-height: 1.6; }
    .pending-text a { color: var(--accent); text-decoration: underline; }
    .pending-pay-info { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; font-size: 13px; }
    .pending-pay-info strong { color: var(--color-fog-dash-muted); margin-right: 4px; }

    .dc-header { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; }
    .dc-title { font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 700; }
    .dc-date { font-size: 14px; color: var(--color-fog-dash-muted); margin-top: 4px; text-transform: capitalize; }
    .dc-chips { display: flex; gap: 10px; }
    .dc-chip { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 10px 18px; text-align: center; min-width: 80px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .dc-chip-num { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 700; color: var(--accent); }
    .dc-chip-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; color: var(--color-fog-dash-muted); text-transform: uppercase; margin-top: 2px; }

    .dc-tabs { display: flex; gap: 22px; border-bottom: 1px solid var(--border); margin-bottom: 22px; overflow-x: auto; }
    .dc-tab { background: none; border: none; padding: 10px 2px 12px; font-size: 15px; font-weight: 500; color: var(--color-fog-dash-muted); border-bottom: 2px solid transparent; cursor: pointer; font-family: 'Inter', sans-serif; white-space: nowrap; display: flex; align-items: center; gap: 6px; }
    .dc-tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
    .dc-tab-count { background: rgba(0,0,0,0.06); color: inherit; font-size: 11px; padding: 1px 7px; border-radius: 999px; }
    .dc-tab.active .dc-tab-count { background: var(--accent-dim); color: var(--accent); }

    .dc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    @media (max-width: 900px) { .dc-grid { grid-template-columns: 1fr; } }

    .order-card { background: #fff; border-radius: 14px; border: 1px solid var(--border); box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.06); overflow: hidden; }
    .order-card.hidden-card { display: none; }
    .oc-head { display: flex; align-items: center; gap: 10px; padding: 16px 18px 0; flex-wrap: wrap; }
    .oc-folio { font-size: 13px; font-weight: 700; color: var(--color-fog-dash-muted); }
    .oc-type-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--accent-dim); color: var(--accent); }
    .oc-status-badge { display: inline-flex; align-items: center; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .oc-time { margin-left: auto; font-size: 13px; color: var(--color-fog-dash-muted); }

    .oc-body { padding: 12px 18px 0; }
    .oc-customer { font-size: 16px; font-weight: 600; margin-bottom: 2px; }
    .oc-address { font-size: 13px; color: var(--color-fog-dash-muted); margin-bottom: 10px; }

    .oc-items { list-style: none; padding: 8px 10px; background: rgba(0,0,0,0.025); border: 1px solid var(--border); border-radius: 8px; display: flex; flex-direction: column; gap: 5px; margin-bottom: 10px; }
    .oc-item-row { display: flex; align-items: baseline; gap: 8px; font-size: 14px; }
    .oc-item-qty { color: var(--accent); font-weight: 700; flex-shrink: 0; min-width: 22px; }
    .oc-item-name { flex: 1; }
    .oc-item-sub { color: var(--color-fog-dash-muted); font-size: 13px; }

    .oc-notes { font-size: 13px; font-style: italic; color: var(--color-fog-dash-muted); background: rgba(199,85,31,0.05); border-radius: 8px; padding: 8px 12px; margin-bottom: 10px; }

    .oc-eta { margin-bottom: 14px; }

    .oc-map-toggle { background: none; border: none; color: var(--accent); font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; padding: 0; margin-bottom: 10px; display: inline-flex; align-items: center; gap: 4px; }
    .oc-map { height: 180px; border-radius: 8px; overflow: hidden; margin-bottom: 12px; border: 1px solid var(--border); }

    .oc-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px 16px; border-top: 1px solid var(--border); flex-wrap: wrap; }
    .oc-total-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; color: var(--color-fog-dash-muted); text-transform: uppercase; }
    .oc-total-amount { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 700; }
    .oc-actions { display: flex; gap: 8px; }
    .oc-btn-primary { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity 0.15s; }
    .oc-btn-primary:hover { opacity: 0.9; }
    .oc-btn-ghost { background: none; border: 1px solid var(--danger-border); color: #c0392b; border-radius: 8px; padding: 10px 14px; font-size: 13px; cursor: pointer; font-family: 'Inter', sans-serif; }

    .dc-empty { text-align: center; padding: 60px 24px; grid-column: 1 / -1; }
    .dc-empty-title { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: var(--color-fog-dash-muted); margin-top: 10px; }
  </style>
</head>
<body data-surface="dashboard">
  <div class="dash-layout">
    <Sidebar business={business} activeNav="pedidos" todaySales={todaySales} todayOrdersCount={todayOrders.length} activeOrdersCount={activeOrdersCount} />

    <main class="dash-content">
      {business.subscription_status !== 'active' && (
        <div class="pending-payment-banner">
          <p class="pending-title">⏳ Tu cuenta está pendiente de activación</p>
          <p class="pending-text">
            Tu tienda pública todavía no es visible para tus clientes. En cuanto recibamos tu primer pago
            ($299 MXN, tu primera mensualidad — sin instalación), la activamos. Mientras tanto, puedes dejar todo listo en
            <a href="/dashboard/menu">tu menú</a>.
          </p>
          {(ownerClabe || ownerPhone) && (
            <div class="pending-pay-info">
              {ownerClabe && <span><strong>CLABE:</strong> {ownerClabe}</span>}
              {ownerPhone && <span><strong>DiMo:</strong> {ownerPhone}</span>}
              {ownerBankName && <span><strong>Banco:</strong> {ownerBankName}</span>}
            </div>
          )}
        </div>
      )}

      <div class="dc-header">
        <div>
          <h1 class="dc-title">Pedidos en vivo</h1>
          <p class="dc-date" id="dc-date">{capitalize(dateLabel)} · {formatTime(now)}</p>
        </div>
        <div class="dc-chips">
          <div class="dc-chip"><p class="dc-chip-num" id="chip-pending">{pendingOrders.length}</p><p class="dc-chip-label">Nuevos</p></div>
          <div class="dc-chip"><p class="dc-chip-num" id="chip-confirmed">{confirmedOrders.length}</p><p class="dc-chip-label">Preparando</p></div>
          <div class="dc-chip"><p class="dc-chip-num" id="chip-ready">{readyOrders.length}</p><p class="dc-chip-label">Listos</p></div>
        </div>
      </div>

      <div class="dc-tabs" id="dc-tabs">
        <button class="dc-tab active" data-tab="active" onclick="dcSetTab('active')">Pedidos <span class="dc-tab-count" id="tab-count-active">{activeOrdersCount}</span></button>
        <button class="dc-tab" data-tab="delivered" onclick="dcSetTab('delivered')">Entregados <span class="dc-tab-count" id="tab-count-delivered">{doneOrders.length}</span></button>
      </div>

      <div class="dc-grid" id="orders-grid">
        {allOrders.length === 0 && (
          <div class="dc-empty">
            <div style="font-size:42px">🔥</div>
            <p class="dc-empty-title">Los pedidos aparecerán aquí</p>
          </div>
        )}

        {allOrders.map(order => {
          const eta = orderEta(order)
          const bucket = bucketOf(order.status)
          return (
            <div class={`order-card${bucket === 'active' ? '' : ' hidden-card'}`} id={`order-${order.id}`} data-bucket={bucket} data-order-status={order.status}>
              <div class="oc-head">
                <span class="oc-folio">#{order.id.slice(-6).toUpperCase()}</span>
                <span class="oc-status-badge" style={`color:${statusColor[order.status]};background:${statusBg[order.status]}`}>{statusLabel[order.status]}</span>
                <span class="oc-type-badge">{order.order_type === 'pickup' ? '↑ Recoger' : '↓ A domicilio'}</span>
                <span class="oc-time">{formatTime(order.created_at)}</span>
              </div>
              <div class="oc-body">
                <p class="oc-customer">{order.customer_name}</p>
                {order.order_type === 'delivery' && order.delivery_address && (
                  <p class="oc-address">📍 {order.delivery_address.address}{order.delivery_address.references && ` — ${order.delivery_address.references}`}</p>
                )}
                {order.order_items && order.order_items.length > 0 && (
                  <ul class="oc-items">
                    {order.order_items.map(item => (
                      <li class="oc-item-row">
                        <span class="oc-item-qty">{item.quantity}×</span>
                        <span class="oc-item-name">{item.name_snap}</span>
                        <span class="oc-item-sub">{formatPrice(item.subtotal)}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {order.notes && <p class="oc-notes">"{order.notes}"</p>}
                <div class="oc-eta">
                  <EtaChip variant="detailed" minutes={eta.minutes} km={eta.km} direction={order.order_type === 'delivery' ? 'delivery' : 'pickup'} />
                </div>
                {order.eta_route_geometry && (
                  <>
                    <button type="button" class="oc-map-toggle" id={`map-toggle-${order.id}`} onclick={`toggleRouteMap('${order.id}')`}>🗺️ Ver ruta ▾</button>
                    <div class="oc-map" id={`map-${order.id}`} style="display:none"></div>
                  </>
                )}
              </div>
              <div class="oc-footer">
                <div>
                  <p class="oc-total-label">Total</p>
                  <p class="oc-total-amount">{formatPrice(order.total)}</p>
                </div>
                <div class="oc-actions" id={`actions-${order.id}`}>
                  {order.status === 'pending' && (<>
                    <button class="oc-btn-primary" onclick={`updateStatus('${order.id}','confirmed')`}>Aceptar pedido</button>
                    <button class="oc-btn-ghost" onclick={`updateStatus('${order.id}','cancelled')`}>Cancelar</button>
                  </>)}
                  {order.status === 'confirmed' && (
                    <button class="oc-btn-primary" onclick={`updateStatus('${order.id}','ready')`}>Marcar listo</button>
                  )}
                  {order.status === 'ready' && (
                    <button class="oc-btn-primary" onclick={`updateStatus('${order.id}','delivered')`}>Marcar entregado</button>
                  )}
                </div>
              </div>
            </div>
          )
        })}
      </div>

      <div class="dc-empty" id="dc-tab-empty" style="display:none">
        <div style="font-size:36px">📭</div>
        <p class="dc-empty-title">No hay pedidos en esta categoría</p>
      </div>
    </main>
  </div>

  <div id="dash-config" data-business-id={business.id} hidden />
  <script type="application/json" id="orders-geometry-data" set:html={JSON.stringify(routeGeometryByOrder)} />
</body>

<script>
  import { createBrowserClient } from '@supabase/ssr'
  import { DEFAULT_PREP_MINUTES } from '../../lib/eta'
  import { statusLabel, statusColor, statusBg, bucketOf } from '../../lib/orderStatus'
  import { renderRouteMap } from '../../lib/routeMap'
  import 'leaflet/dist/leaflet.css'

  const sb = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  )

  const config = document.getElementById('dash-config')
  const businessId = config.dataset.businessId

  // Geometrías de ruta de los pedidos ya renderizados por el servidor
  // — las de pedidos nuevos (Realtime) se agregan directo en
  // addOrderCard, porque ahí el objeto `order` completo ya las trae.
  const routeGeometries = new Map(
    Object.entries(JSON.parse(document.getElementById('orders-geometry-data')?.textContent || '{}'))
  )
  const routeMaps = new Map()

  window.toggleRouteMap = (orderId) => {
    const container = document.getElementById(`map-${orderId}`)
    const btn = document.getElementById(`map-toggle-${orderId}`)
    if (!container) return
    const opening = container.style.display === 'none'
    container.style.display = opening ? 'block' : 'none'
    if (btn) btn.textContent = opening ? '🗺️ Ocultar ruta ▴' : '🗺️ Ver ruta ▾'
    if (!opening) return

    if (routeMaps.has(orderId)) {
      routeMaps.get(orderId).invalidateSize()
      return
    }
    const geometry = routeGeometries.get(orderId)
    if (!geometry?.coordinates?.length) return
    routeMaps.set(orderId, renderRouteMap(`map-${orderId}`, geometry.coordinates, { interactive: false, zoomControl: true }))
  }
  let audioCtx = null
  document.addEventListener('click', () => {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)()
  }, { once: true })

  const formatMXN   = n => new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(n)
  const formatTime  = ts => new Date(ts).toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})

  // Reloj en vivo del encabezado — solo actualiza la hora, la fecha no cambia en sesión.
  setInterval(() => {
    const el = document.getElementById('dc-date')
    if (!el) return
    const parts = el.textContent.split('·')
    el.textContent = `${parts[0].trim()} · ${formatTime(new Date())}`
  }, 30000)

  let activeTab = 'active'
  window.dcSetTab = (tab) => {
    activeTab = tab
    document.querySelectorAll('.dc-tab').forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tab))
    let visibleCount = 0
    document.querySelectorAll('.order-card').forEach(card => {
      const match = card.dataset.bucket === tab
      card.classList.toggle('hidden-card', !match)
      if (match) visibleCount++
    })
    const empty = document.getElementById('dc-tab-empty')
    if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none'
  }

  function refreshCounts() {
    // pending/confirmed/ready se cuentan por estado exacto (para los
    // chips del encabezado); active/delivered son los dos buckets de
    // las pestañas, y ya no distinguen entre sí los estados activos.
    const counts = { pending: 0, confirmed: 0, ready: 0, delivered: 0 }
    document.querySelectorAll('.order-card').forEach(card => {
      const s = card.dataset.orderStatus
      if (s === 'pending' || s === 'confirmed' || s === 'ready') counts[s]++
      else counts.delivered++
    })
    document.getElementById('chip-pending').textContent = counts.pending
    document.getElementById('chip-confirmed').textContent = counts.confirmed
    document.getElementById('chip-ready').textContent = counts.ready
    document.getElementById('tab-count-active').textContent = counts.pending + counts.confirmed + counts.ready
    document.getElementById('tab-count-delivered').textContent = counts.delivered
    const empty = document.getElementById('dc-tab-empty')
    if (empty) {
      const visible = document.querySelectorAll(`.order-card[data-bucket="${activeTab}"]`).length
      empty.style.display = visible === 0 ? 'block' : 'none'
    }
  }

  function etaChipHtml(order) {
    // Se duplica aquí porque las tarjetas insertadas por Realtime se
    // arman en HTML plano, no como componente Astro. Mismo criterio
    // que orderEta() en el frontmatter: ambos tipos de pedido usan el
    // ETA real guardado en el pedido cuando existe (OSRM, calculado en
    // el checkout para domicilio o en /pedido/[id] para recoger); si
    // no hay uno guardado todavía, cae al tiempo de preparación.
    const isDelivery = order.order_type === 'delivery'
    const hasKm = order.eta_minutes != null
    const minutes = hasKm ? order.eta_minutes : DEFAULT_PREP_MINUTES
    const icon = isDelivery
      ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>'
      : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>'
    const distanceCol = hasKm ? `
        <div class="eta-col eta-col-right" style="display:flex;flex-direction:column;gap:3px;align-items:flex-end">
          <span class="eta-label" style="font-size:10px;font-weight:700;letter-spacing:0.8px;color:#8A7A62;text-transform:uppercase">DISTANCIA</span>
          <span class="eta-value" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#1C1208">${order.eta_km} <em style="font-style:normal;font-size:13px;color:#8A7A62">km</em></span>
        </div>` : ''
    return `<div class="eta-chip eta-chip-detailed" style="display:flex;align-items:center;gap:12px;background:rgba(199,85,31,0.07);border:1px solid rgba(199,85,31,0.18);border-radius:10px;padding:10px 14px">
      <div class="eta-icon" style="width:28px;height:28px;border-radius:50%;flex-shrink:0;background:rgba(199,85,31,0.14);color:#C7551F;display:flex;align-items:center;justify-content:center">${icon}</div>
      <div class="eta-cols" style="flex:1;display:flex;align-items:baseline;justify-content:space-between;gap:12px">
        <div class="eta-col" style="display:flex;flex-direction:column;gap:3px">
          <span class="eta-label" style="font-size:10px;font-weight:700;letter-spacing:0.8px;color:#8A7A62;text-transform:uppercase">${isDelivery ? 'A DOMICILIO' : 'AL RESTAURANTE'}</span>
          <span class="eta-value" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#1C1208">${minutes} <em style="font-style:normal;font-size:13px;color:#8A7A62">min</em></span>
        </div>${distanceCol}
      </div>
    </div>`
  }

  function escapeHtml(str) {
    const div = document.createElement('div')
    div.textContent = str ?? ''
    return div.innerHTML
  }

  // Única fuente de verdad para los botones de acción por estado — la
  // usan tanto addOrderCard (pedido nuevo) como applyOrderStatus
  // (transición, propia o de otro dispositivo vía Realtime), para no
  // repetir el marcado en dos lugares que se puedan desincronizar.
  function actionsHtmlFor(orderId, status) {
    if (status === 'pending') {
      return `
        <button class="oc-btn-primary" onclick="updateStatus('${orderId}','confirmed')">Aceptar pedido</button>
        <button class="oc-btn-ghost" onclick="updateStatus('${orderId}','cancelled')">Cancelar</button>`
    }
    if (status === 'confirmed') {
      return `<button class="oc-btn-primary" onclick="updateStatus('${orderId}','ready')">Marcar listo</button>`
    }
    if (status === 'ready') {
      return `<button class="oc-btn-primary" onclick="updateStatus('${orderId}','delivered')">Marcar entregado</button>`
    }
    return ''
  }

  // Aplica un estado de pedido a su tarjeta: la mueve a su pestaña
  // (o la oculta si no es la activa) y refresca sus botones. Se llama
  // tanto al hacer clic localmente (respuesta instantánea) como desde
  // el evento UPDATE de Realtime (para reflejar cambios hechos desde
  // otro dispositivo/pestaña) — aplicar el mismo estado dos veces es
  // inofensivo.
  function applyOrderStatus(order) {
    const card = document.getElementById(`order-${order.id}`)
    if (!card) return
    const bucket = bucketOf(order.status)
    card.dataset.bucket = bucket
    card.dataset.orderStatus = order.status
    card.classList.toggle('hidden-card', bucket !== activeTab)

    const badge = card.querySelector('.oc-status-badge')
    if (badge) {
      badge.textContent = statusLabel[order.status]
      badge.style.color = statusColor[order.status]
      badge.style.background = statusBg[order.status]
    }

    const actions = document.getElementById(`actions-${order.id}`)
    if (actions) actions.innerHTML = actionsHtmlFor(order.id, order.status)
    refreshCounts()
  }

  // A diferencia de Domicilio (ETA real ya viene en el pedido desde
  // que se crea, en el checkout), Recoger solo tiene el ETA real
  // después: se calcula y guarda desde /pedido/[id] una vez que el
  // cliente entrega su geolocalización, lo cual llega aquí como un
  // UPDATE por Realtime en vez de venir ya en la tarjeta recién creada
  // — por eso hace falta refrescar el chip y aparecer el botón "Ver
  // ruta" cuando ese UPDATE trae el ETA real por primera vez.
  function refreshOrderEta(order) {
    if (order.eta_minutes == null) return
    const card = document.getElementById(`order-${order.id}`)
    if (!card) return

    const etaSlot = card.querySelector('.oc-eta')
    if (etaSlot) etaSlot.innerHTML = etaChipHtml(order)

    if (etaSlot && order.eta_route_geometry && !routeGeometries.has(order.id)) {
      routeGeometries.set(order.id, order.eta_route_geometry)
      if (!document.getElementById(`map-toggle-${order.id}`)) {
        etaSlot.insertAdjacentHTML('afterend', `
          <button type="button" class="oc-map-toggle" id="map-toggle-${order.id}" onclick="toggleRouteMap('${order.id}')">🗺️ Ver ruta ▾</button>
          <div class="oc-map" id="map-${order.id}" style="display:none"></div>`)
      }
    }
  }

  window.updateStatus = async (orderId, newStatus) => {
    const { error } = await sb.from('orders').update({ status: newStatus }).eq('id', orderId)
    if (error) return
    applyOrderStatus({ id: orderId, status: newStatus })
  }

  async function addOrderCard(order) {
    const grid = document.getElementById('orders-grid')
    const card = document.createElement('div')
    card.id = `order-${order.id}`
    card.className = 'order-card'
    card.dataset.bucket = 'active'
    card.dataset.orderStatus = 'pending'
    if (activeTab !== 'active') card.classList.add('hidden-card')

    const hasRoute = !!order.eta_route_geometry
    if (hasRoute) routeGeometries.set(order.id, order.eta_route_geometry)

    const { data: items } = await sb.from('order_items').select('*').eq('order_id', order.id)
    const itemsHtml = (items && items.length > 0)
      ? `<ul class="oc-items">${items.map(item => `
          <li class="oc-item-row">
            <span class="oc-item-qty">${item.quantity}×</span>
            <span class="oc-item-name">${escapeHtml(item.name_snap)}</span>
            <span class="oc-item-sub">${formatMXN(item.subtotal)}</span>
          </li>`).join('')}</ul>`
      : ''

    card.innerHTML = `
      <div class="oc-head">
        <span class="oc-folio">#${order.id.slice(-6).toUpperCase()}</span>
        <span class="oc-status-badge" style="color:${statusColor.pending};background:${statusBg.pending}">${statusLabel.pending}</span>
        <span class="oc-type-badge">${order.order_type === 'pickup' ? '↑ Recoger' : '↓ A domicilio'}</span>
        <span class="oc-time">${formatTime(order.created_at)}</span>
      </div>
      <div class="oc-body">
        <p class="oc-customer">${escapeHtml(order.customer_name)}</p>
        ${order.order_type === 'delivery' && order.delivery_address ? `
          <p class="oc-address">📍 ${escapeHtml(order.delivery_address.address)}${order.delivery_address.references ? ' — ' + escapeHtml(order.delivery_address.references) : ''}</p>` : ''}
        ${itemsHtml}
        ${order.notes ? `<p class="oc-notes">"${escapeHtml(order.notes)}"</p>` : ''}
        <div class="oc-eta">${etaChipHtml(order)}</div>
        ${hasRoute ? `
          <button type="button" class="oc-map-toggle" id="map-toggle-${order.id}" onclick="toggleRouteMap('${order.id}')">🗺️ Ver ruta ▾</button>
          <div class="oc-map" id="map-${order.id}" style="display:none"></div>` : ''}
      </div>
      <div class="oc-footer">
        <div>
          <p class="oc-total-label">Total</p>
          <p class="oc-total-amount">${formatMXN(order.total)}</p>
        </div>
        <div class="oc-actions" id="actions-${order.id}">${actionsHtmlFor(order.id, 'pending')}</div>
      </div>`
    grid.insertAdjacentElement('afterbegin', card)
    refreshCounts()
  }

  async function startOrdersRealtime() {
    const { data: { session } } = await sb.auth.getSession()
    if (session) sb.realtime.setAuth(session.access_token)

    sb.channel('orders-realtime')
      .on('postgres_changes', { event:'INSERT', schema:'public', table:'orders', filter:`business_id=eq.${businessId}` },
        async payload => {
          await addOrderCard(payload.new)
          playOrderSound()
          sendOrderNotification(payload.new)
        })
      .on('postgres_changes', { event:'UPDATE', schema:'public', table:'orders', filter:`business_id=eq.${businessId}` },
        payload => { applyOrderStatus(payload.new); refreshOrderEta(payload.new) })
      .subscribe()
  }
  startOrdersRealtime()

  sb.auth.onAuthStateChange((_event, session) => {
    if (session) sb.realtime.setAuth(session.access_token)
  })

  function playOrderSound() {
    try {
      const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)()
      const times = [0, 0.15, 0.3]
      times.forEach(t => {
        const osc = ctx.createOscillator()
        const gain = ctx.createGain()
        osc.connect(gain); gain.connect(ctx.destination)
        osc.frequency.value = 880
        osc.type = 'sine'
        gain.gain.setValueAtTime(0, ctx.currentTime + t)
        gain.gain.linearRampToValueAtTime(0.4, ctx.currentTime + t + 0.02)
        gain.gain.linearRampToValueAtTime(0, ctx.currentTime + t + 0.18)
        osc.start(ctx.currentTime + t)
        osc.stop(ctx.currentTime + t + 0.2)
      })
    } catch(e) {}
  }

  function sendOrderNotification(order) {
    if (Notification.permission !== 'granted') return
    const n = new Notification('🔥 Nuevo pedido — Fogón', {
      body: `${order.customer_name} · ${new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(order.total)} · ${order.order_type === 'pickup' ? '🏪 Recoger' : '🛵 Domicilio'}`,
      icon: '/favicon.svg',
      badge: '/favicon.svg',
      vibrate: [200, 100, 200],
      tag: 'new-order',
      renotify: true
    })
    n.onclick = () => { window.focus(); n.close() }
  }
</script>
</html>
