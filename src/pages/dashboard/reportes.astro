---
export const prerender = false
import '../../styles/global.css'
import { createServerClient, parseCookieHeader } from '@supabase/ssr'
import Sidebar from '../../components/dashboard/Sidebar.astro'

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() { return parseCookieHeader(Astro.request.headers.get('Cookie') ?? '') },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => Astro.cookies.set(name, value, options))
      },
    },
  }
)

const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

const { data: business } = await supabase
  .from('businesses').select('*').eq('owner_id', user.id).single()
if (!business) return Astro.redirect('/login')

const { data: orders } = await supabase
  .from('orders')
  .select('*, order_items(name_snap, quantity, subtotal)')
  .eq('business_id', business.id)
  .eq('status', 'delivered')
  .order('created_at', { ascending: false })

const allOrders = orders ?? []

const now = new Date()
const startOfDay   = (d) => { const x = new Date(d); x.setHours(0,0,0,0); return x }
const startOfWeek  = () => { const d = new Date(now); d.setDate(now.getDate() - now.getDay()); d.setHours(0,0,0,0); return d }
const startOfMonth = () => new Date(now.getFullYear(), now.getMonth(), 1)
const startOfYear  = () => new Date(now.getFullYear(), 0, 1)

const filter = (from) => allOrders.filter(o => new Date(o.created_at) >= from)

const todayOrders  = filter(startOfDay(now))
const weekOrders   = filter(startOfWeek())
const monthOrders  = filter(startOfMonth())
const yearOrders   = filter(startOfYear())

const sum = (arr) => arr.reduce((s, o) => s + Number(o.total), 0)
const avg = (arr) => arr.length ? sum(arr) / arr.length : 0

const last7 = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(now)
  d.setDate(now.getDate() - (6 - i))
  const dayStart = startOfDay(d)
  const dayEnd   = new Date(dayStart); dayEnd.setDate(dayEnd.getDate() + 1)
  const dayOrders = allOrders.filter(o => {
    const t = new Date(o.created_at)
    return t >= dayStart && t < dayEnd
  })
  return {
    label: d.toLocaleDateString('es-MX', { weekday: 'short', day: 'numeric' }),
    total: sum(dayOrders),
    count: dayOrders.length
  }
})

const maxDay = Math.max(...last7.map(d => d.total), 1)

const productMap = new Map()
monthOrders.forEach(order => {
  (order.order_items ?? []).forEach(item => {
    const prev = productMap.get(item.name_snap) ?? { qty: 0, revenue: 0 }
    productMap.set(item.name_snap, {
      qty: prev.qty + item.quantity,
      revenue: prev.revenue + Number(item.subtotal)
    })
  })
})
const topProducts = [...productMap.entries()]
  .map(([name, data]) => ({ name, ...data }))
  .sort((a, b) => b.qty - a.qty)
  .slice(0, 5)

const formatPrice = (n) => new Intl.NumberFormat('es-MX', { style:'currency', currency:'MXN' }).format(n)
// Solo para las cifras del sidebar (recaudado hoy / en curso) — la
// consulta de arriba solo trae pedidos entregados, no sirve para esto.
const { data: ordersForStats } = await supabase
  .from('orders').select('status, total, created_at').eq('business_id', business.id).limit(50)
const allOrdersForStats = ordersForStats ?? []
const todayStr = new Date().toDateString()
const sidebarTodaySales = allOrdersForStats.filter(o => new Date(o.created_at).toDateString() === todayStr).reduce((s,o) => s + Number(o.total), 0)
const sidebarTodayCount = allOrdersForStats.filter(o => new Date(o.created_at).toDateString() === todayStr).length
const sidebarActiveCount = allOrdersForStats.filter(o => o.status === 'pending' || o.status === 'confirmed' || o.status === 'ready').length
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reportes — {business.name}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg-deep:       var(--color-fog-dash-bg);
      --bg-body:       var(--color-fog-dash-bg);
      --bg-surface:    var(--color-fog-dash-panel);
      --bg-hover:      var(--color-fog-dash-panel);
      --text-1:        var(--color-fog-dash-text);
      --text-2:        var(--color-fog-dash-muted);
      --text-3:        var(--color-fog-dash-muted);
      --accent:        var(--color-fog-brasa);
      --accent-dim:    rgba(199,85,31,0.12);
      --accent-border: rgba(199,85,31,0.28);
      --border:        var(--color-fog-dash-border);
    }
    body { background: var(--bg-body); color: var(--text-1); font-family: 'Inter', sans-serif; min-height: 100vh; font-size: 16px; }

    .dash-layout { display: flex; min-height: 100vh; }
    @media (max-width: 900px) { .dash-layout { flex-direction: column; } }
    .dash-content-wrap { flex: 1; min-width: 0; padding: 28px 32px 48px; }
    @media (max-width: 640px) { .dash-content-wrap { padding: 20px 16px 32px; } }
    .dc-top-links { display: flex; justify-content: flex-end; gap: 16px; margin-bottom: 12px; }
    .dc-top-links a, .dc-top-links button { font-size: 13px; color: var(--text-3); text-decoration: none; background: none; border: none; cursor: pointer; font-family: 'Inter', sans-serif; }
    .dc-top-links a:hover, .dc-top-links button:hover { color: var(--text-2); }

    .main { max-width: 960px; margin: 0 auto; padding: 0; position: relative; z-index: 1; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 24px; }
    @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(4,1fr); } }
    .stat-card { background: var(--bg-surface); border-radius: 14px; padding: 20px 22px; border: 1px solid var(--border); }
    .stat-period { font-size: 12px; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; }
    .stat-amount { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 700; color: var(--accent); margin-bottom: 5px; }
    .stat-count { font-size: 13px; color: var(--text-2); }
    .stat-avg   { font-size: 13px; color: var(--text-3); margin-top: 3px; }

    /* Secciones */
    .section { background: var(--bg-surface); border-radius: 14px; border: 1px solid var(--border); padding: 24px; margin-bottom: 16px; }
    .section-title { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 700; color: var(--text-1); margin-bottom: 20px; }

    /* Gráfica */
    .bar-chart { display: flex; align-items: flex-end; gap: 8px; height: 130px; padding-bottom: 30px; position: relative; }
    .bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0; height: 100%; justify-content: flex-end; position: relative; }
    .bar {
      width: 100%; border-radius: 4px 4px 0 0;
      background: var(--accent-dim);
      border: 1px solid var(--accent-border);
      transition: background 0.2s;
      position: relative; min-height: 3px;
    }
    .bar:hover { background: rgba(199,85,31,0.28); }
    .bar-value {
      position: absolute; top: -22px; left: 50%;
      transform: translateX(-50%);
      font-size: 11px; color: var(--accent); font-weight: 600;
      white-space: nowrap; opacity: 0; transition: opacity 0.15s;
    }
    .bar:hover .bar-value { opacity: 1; }
    .bar-label { position: absolute; bottom: -26px; left: 50%; transform: translateX(-50%); font-size: 11px; color: var(--text-3); white-space: nowrap; }

    /* Top productos */
    .top-product { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--border); }
    .top-product:last-child { border-bottom: none; }
    .top-rank { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 700; color: var(--text-3); width: 28px; flex-shrink: 0; }
    .top-rank.gold { color: var(--accent); }
    .top-name { flex: 1; font-size: 15px; font-weight: 500; color: var(--text-1); }
    .top-qty { font-size: 14px; color: var(--text-2); }
    .top-revenue { font-size: 15px; font-weight: 600; color: var(--accent); }

    .progress-bar { height: 4px; background: var(--bg-deep); border-radius: 2px; margin-top: 6px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--accent); border-radius: 2px; }

    .empty { text-align: center; padding: 60px; color: var(--text-3); }

    /* Botón imprimir */
    .print-btn{
      display:flex;align-items:center;gap:8px;
      background:var(--accent-dim);color:var(--accent);
      border:1px solid var(--accent-border);border-radius:10px;
      padding:10px 18px;font-size:14px;font-weight:600;
      cursor:pointer;font-family:'Inter',sans-serif;
      transition:opacity 0.15s;text-decoration:none;
    }
    .print-btn:hover{opacity:0.8}

    /* Estilos de impresión */
    @media print {
      body{background:#fff !important;color:#1a1a1a !important;font-size:13px}
      .dash-sidebar,.dc-top-links,.print-btn{display:none !important}
      .main{padding:0;max-width:100%}
      .stat-card{background:#f9f9f9 !important;border:1px solid #ddd !important;break-inside:avoid}
      .stat-period{color:#666 !important}
      .stat-amount{color:#C7551F !important}
      .stat-count,.stat-avg{color:#444 !important}
      .section{background:#f9f9f9 !important;border:1px solid #ddd !important;break-inside:avoid;page-break-inside:avoid}
      .section-title{color:#1a1a1a !important}
      .bar{background:#f2d5d0 !important;border:1px solid #C7551F !important;opacity:1}      
      .top-name{color:#1a1a1a !important}
      .top-rank{color:#999 !important}
      .top-rank.gold{color:#C7551F !important}
      .top-qty{color:#555 !important}
      .top-revenue{color:#C7551F !important}
      .progress-fill{background:#C7551F !important}
      .progress-bar{background:#eee !important}
      .top-product{border-bottom-color:#eee !important}
      .print-header{display:block !important}
    }
    .print-header{display:none;margin-bottom:24px}
    .print-header h1{font-family:'Cormorant Garamond',serif;font-size:24px;color:#C7551F}
    .print-header p{font-size:12px;color:#888;margin-top:4px}

    .empty p { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--text-2); margin-top: 10px; }
  </style>
</head>

<body data-surface="dashboard">
<div class="dash-layout">
  <Sidebar business={business} activeNav="reportes" todaySales={sidebarTodaySales} todayOrdersCount={sidebarTodayCount} activeOrdersCount={sidebarActiveCount} />
  <div class="dash-content-wrap">

  <div class="dc-top-links">
    <button class="print-btn" onclick="window.print()"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>Imprimir / PDF</button>
    <a href={`/${business.slug}`} target="_blank">Ver tienda ↗</a>
  </div>

  <main class="main">
    <div class="print-header">
      <h1>Reporte de ventas — {business.name}</h1>
      <p>Generado el {new Date().toLocaleDateString('es-MX', {year:'numeric',month:'long',day:'numeric'})}</p>
    </div>

    {allOrders.length === 0 && (
      <div class="empty">
        <p style="font-size:40px">📊</p>
        <p>Los reportes aparecerán cuando tengas pedidos entregados</p>
      </div>
    )}

    {allOrders.length > 0 && (<>

      <div class="stats-grid">
        <div class="stat-card">
          <p class="stat-period">Hoy</p>
          <p class="stat-amount">{formatPrice(sum(todayOrders))}</p>
          <p class="stat-count">{todayOrders.length} pedidos</p>
          <p class="stat-avg">Ticket: {formatPrice(avg(todayOrders))}</p>
        </div>
        <div class="stat-card">
          <p class="stat-period">Esta semana</p>
          <p class="stat-amount">{formatPrice(sum(weekOrders))}</p>
          <p class="stat-count">{weekOrders.length} pedidos</p>
          <p class="stat-avg">Ticket: {formatPrice(avg(weekOrders))}</p>
        </div>
        <div class="stat-card">
          <p class="stat-period">Este mes</p>
          <p class="stat-amount">{formatPrice(sum(monthOrders))}</p>
          <p class="stat-count">{monthOrders.length} pedidos</p>
          <p class="stat-avg">Ticket: {formatPrice(avg(monthOrders))}</p>
        </div>
        <div class="stat-card">
          <p class="stat-period">Este año</p>
          <p class="stat-amount">{formatPrice(sum(yearOrders))}</p>
          <p class="stat-count">{yearOrders.length} pedidos</p>
          <p class="stat-avg">Ticket: {formatPrice(avg(yearOrders))}</p>
        </div>
      </div>

      <div class="section">
        <p class="section-title">Ventas — últimos 7 días</p>
        <div class="bar-chart">
          {last7.map(day => (
            <div class="bar-wrap">
              <div
                class="bar"
                style={`height:${Math.max((day.total / maxDay) * 100, day.total > 0 ? 4 : 0)}%`}
              >
                <span class="bar-value">{formatPrice(day.total)}</span>
              </div>
              <span class="bar-label">{day.label}</span>
            </div>
          ))}
        </div>
      </div>

      {topProducts.length > 0 && (
        <div class="section">
          <p class="section-title">Más vendidos — este mes</p>
          {topProducts.map((product, i) => (
            <div class="top-product">
              <span class={`top-rank ${i === 0 ? 'gold' : ''}`}>{i + 1}</span>
              <div style="flex:1;min-width:0">
                <p class="top-name">{product.name}</p>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width:${(product.qty / topProducts[0].qty) * 100}%`}></div>
                </div>
              </div>
              <p class="top-qty" style="margin-right:14px">{product.qty} uds</p>
              <p class="top-revenue">{formatPrice(product.revenue)}</p>
            </div>
          ))}
        </div>
      )}

    </>)}
  </main>

  <div id="reportes-cfg" data-bid={business.id} hidden></div>
  </div>
</div>
</body>

<script>
  import { createBrowserClient } from '@supabase/ssr'
  const sb = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  )

  // ── Alerta de pedido nuevo (sonido + notificación) ──
  // Pedidos/Menú/Reportes son páginas completas separadas — sin esta
  // suscripción repetida aquí también, la alerta solo sonaría
  // mientras el usuario está en la pestaña de Pedidos.
  const reportesCfg = document.getElementById('reportes-cfg')
  const orderAlertBid = reportesCfg.dataset.bid

  let audioCtx = null
  document.addEventListener('click', () => {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)()
  })

  function playOrderSound() {
    try {
      const ctx = audioCtx || new (window.AudioContext || window.webkitAudioContext)()
      const times = [0, 0.15, 0.3]
      times.forEach(t => {
        const osc = ctx.createOscillator()
        const gain = ctx.createGain()
        osc.connect(gain); gain.connect(ctx.destination)
        osc.frequency.value = 880
        osc.type = 'sine'
        gain.gain.setValueAtTime(0, ctx.currentTime + t)
        gain.gain.linearRampToValueAtTime(0.4, ctx.currentTime + t + 0.02)
        gain.gain.linearRampToValueAtTime(0, ctx.currentTime + t + 0.18)
        osc.start(ctx.currentTime + t)
        osc.stop(ctx.currentTime + t + 0.2)
      })
    } catch (e) {}
  }

  function sendOrderNotification(order) {
    if (Notification.permission !== 'granted') return
    const n = new Notification('🔥 Nuevo pedido — Fogón', {
      body: `${order.customer_name} · ${new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(order.total)} · ${order.order_type === 'pickup' ? '🏪 Recoger' : '🛵 Domicilio'}`,
      icon: '/favicon.svg',
      badge: '/favicon.svg',
      vibrate: [200, 100, 200],
      tag: 'new-order',
      renotify: true
    })
    n.onclick = () => { window.focus(); n.close() }
  }

  async function startOrderAlertRealtime() {
    const { data: { session } } = await sb.auth.getSession()
    if (session) sb.realtime.setAuth(session.access_token)

    sb.channel('orders-alert')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'orders', filter: `business_id=eq.${orderAlertBid}` },
        payload => {
          playOrderSound()
          sendOrderNotification(payload.new)
        })
      .subscribe()
  }
  startOrderAlertRealtime()

  sb.auth.onAuthStateChange((_event, session) => {
    if (session) sb.realtime.setAuth(session.access_token)
  })
</script>
</html>